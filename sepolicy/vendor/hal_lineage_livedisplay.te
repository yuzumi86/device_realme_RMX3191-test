type hal_lineage_livedisplay_RMX3191, domain;
hal_server_domain(hal_lineage_livedisplay_RMX3191, hal_lineage_livedisplay)

type hal_lineage_livedisplay_RMX3191_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lineage_livedisplay_RMX3191)

# Allow LiveDisplay HAL's default implementation to use vendor-binder service
vndbinder_use(hal_lineage_livedisplay_RMX3191)

allow hal_lineage_livedisplay_RMX3191 vendor_sysfs_graphics:file rw_file_perms;
allow hal_lineage_livedisplay_RMX3191 vendor_sysfs_graphics:dir search;